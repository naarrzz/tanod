# Copy to .env (gitignored) and fill in. Used by the demo and the alert helpers.
TANOD_ALERT_ENDPOINT=https://api.telegram.org
TANOD_BOT_TOKEN=
TANOD_CHAT_ID=
# Optional: an MJPEG stream from a phone camera app, e.g. http://192.168.1.23:8080/video
# Leave empty to use a camera on this laptop (or an iPhone through Continuity Camera).
TANOD_CAMERA_URL=
